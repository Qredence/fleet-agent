{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentCapabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_mode",
    "supported_content_types"
  ],
  "properties": {
    "agent_mode": {
      "type": "string",
      "enum": [
        "fixtures",
        "engine"
      ]
    },
    "supported_content_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text"
        ]
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    }
  }
}
