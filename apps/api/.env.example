FLEET_AGENT_ENVIRONMENT=development
FLEET_AGENT_CORS_ORIGINS='["http://localhost:5173"]'

# fixtures (default): replay canonical NDJSON mock streams — no LLM needed.
# engine: run the live DSPy ReActV2 bridge — requires FLEET_AGENT_LLM_API_KEY.
FLEET_AGENT_AGENT_MODE=fixtures

FLEET_AGENT_LLM_MODEL=openai/gpt-4o-mini
# Databricks AI Gateway needs a workspace PAT (dapi…), not a Daytona dtn_ token.
# FLEET_AGENT_LLM_API_KEY=dapi…
# FLEET_AGENT_LLM_BASE_URL=https://<workspace>.gcp.databricks.com/ai-gateway/openai/v1
# FLEET_AGENT_LLM_MAX_ITERS=6
# FLEET_AGENT_LLM_TEMPERATURE=0.2

# Local default provider trio (reads unprefixed MODAL_* env vars). When
# MODAL_MODEL_ID is set, these take precedence over FLEET_AGENT_LLM_* as the
# server-side default; browser provider profiles (settings dialog) still take
# precedence per run. Custom-base-URL providers send the model id to the
# gateway verbatim (a leading "openai/" is treated as a routing marker and
# stripped); bare gateway ids like zai-org/GLM-5.3-Flash work as-is.
# MODAL_API_KEY=real-key-here
# MODAL_BASE_URL=https://fleet-proxy.modal.run/v1
# MODAL_MODEL_ID=zai-org/GLM-5.3-Flash

# Allow browser provider profiles to target local LLM servers (loopback or
# private endpoints). Off by default: the browser must not be able to direct
# the server at internal addresses.
# FLEET_AGENT_LLM_ALLOW_PRIVATE_BASE_URLS=false

# Hardening (defaults shown)
# FLEET_AGENT_RUN_TIMEOUT_SECONDS=300
# FLEET_AGENT_MAX_CONCURRENT_RUNS=4
# FLEET_AGENT_MAX_BODY_BYTES=1048576
# FLEET_AGENT_API_KEY=set-to-require-X-API-Key-on-/api/*
# FLEET_AGENT_ARTIFACTS_DIR=.artifacts

# Web search (Tavily REST) — enables the web_search / fetch_page engine tools.
# FLEET_AGENT_TAVILY_API_KEY=tvly-...
# Optional fallback for restricted local DNS environments.
# FLEET_AGENT_TAVILY_DNS_FALLBACK=false
# Set false for OpenAI-compatible gateways without native tool calling.
# FLEET_AGENT_LLM_NATIVE_FUNCTION_CALLING=true
# Optional trusted attribution for browser BYOK requests. The browser never
# supplies provider attribution headers to the Fleet Agent API.
# FLEET_AGENT_OPENROUTER_HTTP_REFERER=https://fleet-agent.example

# Workspace tools (read-only inspection is on by default in development).
# FLEET_AGENT_WORKSPACE_ROOT=/workspace/fleet-agent
# FLEET_AGENT_WORKSPACE_READ_TOOLS_ENABLED=true
# FLEET_AGENT_WORKSPACE_WRITE_TOOLS_ENABLED=false
# FLEET_AGENT_WORKSPACE_BASH_TOOL_ENABLED=false
# FLEET_AGENT_WORKSPACE_MAX_READ_BYTES=262144
# FLEET_AGENT_WORKSPACE_MAX_WRITE_BYTES=1048576
# FLEET_AGENT_WORKSPACE_MAX_OUTPUT_CHARS=12000
# FLEET_AGENT_WORKSPACE_BASH_DEFAULT_TIMEOUT_SECONDS=30
# FLEET_AGENT_WORKSPACE_BASH_MAX_TIMEOUT_SECONDS=120

# Experimental Flex/GEPA track; production defaults to routed ReActV2.
# The read-only Flex track runs dspy.Flex's sandboxed interpreter and needs
# a local Deno runtime (>= 2.0.0, < 3.0.0) on PATH.
# FLEET_AGENT_REASONING_PROGRAM=react
# FLEET_AGENT_FLEX_ENABLED=false
# FLEET_AGENT_FLEX_ALLOW_MUTATING_TOOLS=false
# FLEET_AGENT_FLEX_MAX_PREDICTOR_CALLS=12

# Promoted GEPA-evolved Flex router (python -m evals.optimize --promote).
# Pin the state file to replace the baseline router predictor; the evolved
# source runs only inside dspy's Deno sandbox. Unset keeps the baseline.
# FLEET_AGENT_ROUTER_STATE=./evals/artifacts/flex_router_active.json

# MLflow observability. Offline evals and optimization attempts always log
# to the tracking store (default: local SQLite at .artifacts/mlflow.db).
# Live dspy tracing is opt-in — traces capture LLM prompts/completions by
# design, so enabling them is an explicit operator decision.
# FLEET_AGENT_MLFLOW_TRACING=false
# FLEET_AGENT_MLFLOW_TRACKING_URI=sqlite:///.artifacts/mlflow.db
